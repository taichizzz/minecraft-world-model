<?xml version="1.0" encoding="UTF-8"?>
<Mission xmlns="http://ProjectMalmo.microsoft.com"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <About>
    <Summary>Env5 - known blocks, NEW medium obstacle layout (generalization test)</Summary>
  </About>

  <ServerSection>
    <ServerInitialConditions>
      <Time>
        <StartTime>6000</StartTime>
        <AllowPassageOfTime>false</AllowPassageOfTime>
      </Time>
    </ServerInitialConditions>

    <ServerHandlers>
      <FlatWorldGenerator generatorString="3;7,220*1,5*3,2;3;,biome_1"/>

      <DrawingDecorator>
        <!-- Floor -->
        <DrawCuboid x1="-5" y1="226" z1="-5" x2="5" y2="226" z2="5" type="stone"/>
        <DrawCuboid x1="-4" y1="227" z1="-4" x2="4" y2="227" z2="4" type="air"/>

        <!-- Main walls (canonical, as in env1/2/3) -->
        <DrawCuboid x1="-5" y1="227" z1="-5" x2="5" y2="230" z2="-5" type="cobblestone"/>
        <DrawCuboid x1="-5" y1="227" z1="5"  x2="5" y2="230" z2="5"  type="planks"/>
        <DrawCuboid x1="-5" y1="227" z1="-5" x2="-5" y2="230" z2="5" type="brick_block"/>
        <DrawCuboid x1="5"  y1="227" z1="-5" x2="5"  y2="230" z2="5" type="glass"/>

        <!-- Wall accents (known blocks, different pattern) -->
        <DrawBlock x="-2" y="229" z="-5" type="stonebrick"/>
        <DrawBlock x="2"  y="228" z="-5" type="stonebrick"/>
        <DrawBlock x="-4" y="230" z="5"  type="mossy_cobblestone"/>
        <DrawBlock x="0"  y="227" z="5"  type="mossy_cobblestone"/>
        <DrawBlock x="3"  y="229" z="5"  type="mossy_cobblestone"/>
        <DrawBlock x="-5" y="227" z="-1" type="stained_glass"/>
        <DrawBlock x="-5" y="230" z="3"  type="stained_glass"/>
        <DrawBlock x="5"  y="229" z="1"  type="planks"/>
        <DrawBlock x="5"  y="227" z="4"  type="planks"/>

        <!-- Obstacles: NEW medium layout (known blocks only) -->
        <DrawBlock x="-2" y="227" z="-2" type="obsidian"/>
        <DrawBlock x="2"  y="227" z="1"  type="obsidian"/>
        <DrawBlock x="-2" y="227" z="2"  type="nether_brick"/>
        <DrawBlock x="-3" y="227" z="-1" type="nether_brick"/>
        <DrawBlock x="0"  y="227" z="0"  type="quartz_block"/>
        <DrawBlock x="1"  y="227" z="2"  type="quartz_block"/>
        <DrawBlock x="2"  y="227" z="-2" type="end_stone"/>
        <DrawBlock x="3"  y="227" z="2"  type="end_stone"/>

        <!-- Goal + landmarks -->
        <DrawBlock x="4"  y="227" z="4"  type="diamond_block"/>
        <DrawBlock x="-4" y="227" z="4"  type="gold_block"/>
        <DrawBlock x="4"  y="227" z="-4" type="emerald_block"/>
      </DrawingDecorator>

      <ServerQuitFromTimeUp timeLimitMs="30000"/>
      <ServerQuitWhenAnyAgentFinishes/>
    </ServerHandlers>
  </ServerSection>

  <AgentSection mode="Survival">
    <Name>Collector</Name>

    <AgentStart>
      <Placement x="{{START_X}}" y="227" z="{{START_Z}}" yaw="{{START_YAW}}" pitch="15"/>
    </AgentStart>

    <AgentHandlers>
      <ObservationFromFullStats/>
      <ObservationFromRay/>

      <VideoProducer>
        <Width>320</Width>
        <Height>320</Height>
      </VideoProducer>

      <DiscreteMovementCommands/>

      <AgentQuitFromTouchingBlockType>
        <Block type="diamond_block"/>
      </AgentQuitFromTouchingBlockType>
    </AgentHandlers>
  </AgentSection>

</Mission>
