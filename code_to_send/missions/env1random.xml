<?xml version="1.0" encoding="UTF-8"?>
<Mission xmlns="http://ProjectMalmo.microsoft.com"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <About>
    <Summary>Planner-Friendly Env1 (Random Spawn Template)</Summary>
  </About>

  <ServerSection>
    <ServerInitialConditions>
      <Time>
        <StartTime>6000</StartTime>
        <AllowPassageOfTime>false</AllowPassageOfTime>
      </Time>
    </ServerInitialConditions>

    <ServerHandlers>
      <FlatWorldGenerator generatorString="3;7,220*1,5*3,2;3;,biome_1"/>

      <DrawingDecorator>
        <!-- Floor -->
        <DrawCuboid x1="-5" y1="226" z1="-5" x2="5" y2="226" z2="5" type="stone"/>

        <!-- Clear interior floor of any leftover blocks from previous missions -->
        <DrawCuboid x1="-4" y1="227" z1="-4" x2="4" y2="227" z2="4" type="air"/>

        <!-- Walls (4 different materials for visual diversity) -->
        <!-- North wall (z = -5) -->
        <DrawCuboid x1="-5" y1="227" z1="-5" x2="5" y2="230" z2="-5" type="cobblestone"/>
        <!-- South wall (z = 5) -->
        <DrawCuboid x1="-5" y1="227" z1="5" x2="5" y2="230" z2="5" type="planks"/>
        <!-- West wall (x = -5) -->
        <DrawCuboid x1="-5" y1="227" z1="-5" x2="-5" y2="230" z2="5" type="brick_block"/>
        <!-- East wall (x = 5) -->
        <DrawCuboid x1="5" y1="227" z1="-5" x2="5" y2="230" z2="5" type="glass"/>

        <!-- Goal + landmarks -->
        <DrawBlock x="4"  y="227" z="4"  type="diamond_block"/>
        <DrawBlock x="-4" y="227" z="4"  type="gold_block"/>
        <DrawBlock x="4"  y="227" z="-4" type="emerald_block"/>
      </DrawingDecorator>

      <ServerQuitFromTimeUp timeLimitMs="30000"/>
      <ServerQuitWhenAnyAgentFinishes/>
    </ServerHandlers>
  </ServerSection>

  <AgentSection mode="Survival">
    <Name>Collector</Name>

    <AgentStart>
      <Placement x="{{START_X}}" y="227" z="{{START_Z}}" yaw="{{START_YAW}}" pitch="15"/>
    </AgentStart>

    <AgentHandlers>
      <ObservationFromFullStats/>
      <ObservationFromRay/>

      <VideoProducer>
        <Width>320</Width>
        <Height>320</Height>
      </VideoProducer>

      <DiscreteMovementCommands/>

      <AgentQuitFromTouchingBlockType>
        <Block type="diamond_block"/>
      </AgentQuitFromTouchingBlockType>
    </AgentHandlers>
  </AgentSection>

</Mission>
